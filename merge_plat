        # ===== OBJECTIVE UI (CENTER TOP) =====
        objective_text = ui_font.render(
            f"Objective: Collect {required_coins} coins and defeat {required_fights} enemies",
            True,
            (255, 255, 255)
        )

        text_width = objective_text.get_width()
        text_height = objective_text.get_height()

        screen_width = screen.get_width()

        x = (screen_width   - text_width) // 2
        y = 10  # top padding

        # background box
        bg_rect = pygame.Rect(
            x - 10,
            y - 5,
            text_width + 20,
            text_height + 10
        )

        pygame.draw.rect(screen, (0, 0, 0), bg_rect, border_radius=6)
        pygame.draw.rect(screen, (255, 255, 255), bg_rect, 2, border_radius=6)

        screen.blit(objective_text, (x, y))

        # ===== ENEMY UI (UNDER COIN UI) =====
        enemy_box_y = box_y + box_size + 8  # under coin box

        enemy_box = pygame.Rect(box_x, enemy_box_y, box_size, box_size)

        pygame.draw.rect(screen, (0, 0, 0), enemy_box, border_radius=8)
        pygame.draw.rect(screen, (200, 50, 50), enemy_box, 2, border_radius=8)

        # enemy icon (use sprite)
        enemy_icon = pygame.transform.scale(enemy_frames[0], (20, 20))
        screen.blit(enemy_icon, (box_x + 6, enemy_box_y + 6))

        # enemy counter text
        if level == 0:
            enemy_text = coin_font.render(f"{enemy_kill_countlevel1}/{required_fights}", True, (255, 255, 255))
            screen.blit(enemy_text, (box_x - 40, enemy_box_y + 8))
        elif level == 1:
            enemy_text = coin_font.render(f"{enemy_kill_countlevel1}/{required_fights}", True, (255, 255, 255))
            screen.blit(enemy_text, (box_x - 40, enemy_box_y + 8))

        pygame.display.flip()
