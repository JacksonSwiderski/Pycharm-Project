def update_and_draw_clouds(screen, dt):
    global clouds

    # initialize timers once
    if not hasattr(update_and_draw_clouds, "spawn_timer"):
        update_and_draw_clouds.spawn_timer = 0

    if not hasattr(update_and_draw_clouds, "next_spawn"):
        update_and_draw_clouds.next_spawn = random.uniform(2, 5)

    # increase timer
    update_and_draw_clouds.spawn_timer += dt

    # spawn cloud
    if update_and_draw_clouds.spawn_timer >= update_and_draw_clouds.next_spawn:

        update_and_draw_clouds.spawn_timer = 0
        update_and_draw_clouds.next_spawn = random.uniform(2, 5)

        img = random.choice(cloud_images)

        new_cloud = {
            "image": img,
            "x": -img.get_width(),
            "y": random.randint(20, 120),
            "speed": random.randint(20, 50)
        }

        clouds.append(new_cloud)

    # move/draw
    for cloud in clouds[:]:
        cloud["x"] += cloud["speed"] * dt

        screen.blit(cloud["image"], (cloud["x"], cloud["y"]))

        # remove offscreen
        if cloud["x"] > screen.get_width() + 200:
            clouds.remove(cloud)

