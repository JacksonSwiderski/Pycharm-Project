        def groundoverlayrepeat(x, y, platform_width, img):
            groundoverlay = []

            start_x = x - 5
            end_x = x + platform_width + 5
            start_y = y - 1

            img_width = img.get_width()
            img_height = img.get_height()

            current_x = start_x

            while current_x < end_x:
                remaining = end_x - current_x

                # width we actually want to draw
                draw_width = min(img_width, remaining)

                # crop the image if needed
                cropped_img = img.subsurface((0, 0, draw_width, img_height))

                groundoverlay.append((cropped_img, (current_x, start_y)))

                current_x += img_width

            return groundoverlay

