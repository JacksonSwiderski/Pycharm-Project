from moves import tackle, bite, solidify

class EnemyData:
    def __init__(self, name, hp, moves, music, music_loop, bg, sprite, scale):
        self.name = name
        self.hp = hp
        self.moves = moves
        self.music = music
        self.music_loop = music_loop
        self.bg = bg
        self.sprite = sprite
        self.scale = scale

