import pygame
import sys
from test_plat import platformer_loop, Enemy, enemy_frames
from test_cmbt import combat_loop
from enemy_data import wrath_king

STATE_MENU, STATE_LEVEL_SELECT, STATE_PLATFORMER, STATE_COMBAT, STATE_SKIN_SELECT = (
    "menu", "level_select", "platformer", "combat", "skin_select"
)

selected_skin = "miku"

# Initialize Pygame
pygame.mixer.pre_init(44100, -16, 2, 512)
pygame.init()
pygame.mixer.init()
pygame.mixer.set_num_channels(16)

# Screen settings
SCREEN_WIDTH, SCREEN_HEIGHT = 800, 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Chrono Clash")

# Images
title = pygame.image.load('ChronoClashLogo.png').convert_alpha()
title = pygame.transform.scale(title, (500, 300))

current_level_assets = 0

# Sounds
click = pygame.mixer.Sound('select.wav')
click.set_volume(0.5)
hover = pygame.mixer.Sound('hover_select.wav')
hover.set_volume(0.5)

# Colors & Fonts
WHITE, GRAY, GREEN = (255, 255, 255), (50, 50, 50), (100, 200, 100)
font = pygame.font.Font(None, 48)
small_font = pygame.font.Font(None, 32)

def reset_level_state():
    global coins, coin_count, coins_generated, enemy_kill_count

    coins = []
    coin_count = 0
    coins_generated = False
    enemy_kill_count = 0

# Game states
STATE_MENU, STATE_LEVEL_SELECT, STATE_PLATFORMER, STATE_COMBAT = "menu", "level_select", "platformer", "combat"

# Global Variables
current_state = STATE_MENU
selected_level = 0
player_x, player_y = 100, 400
button_hovered = False
defeated_enemies = {
    0: [],
    1: [],
    2: []
}
current_enemy = None
show_hitboxes = False
clock = pygame.time.Clock()


def draw_title():
    x_pos = (SCREEN_WIDTH // 2) - (title.get_width() // 2)
    y_pos = 15
    screen.blit(title, (x_pos, y_pos))


def draw_button(text, x, y, width, height, color, hover_color, font_size=32):
    global button_hovered

    mouse = pygame.mouse.get_pos()
    click_state = pygame.mouse.get_pressed()

    rect = pygame.Rect(x, y, width, height)
    is_hovered = rect.collidepoint(mouse)

    if is_hovered:
        if not button_hovered:
            hover.play()
            button_hovered = True

    pygame.draw.rect(
        screen,
        hover_color if is_hovered else color,
        rect,
        border_radius=8
    )

    custom_font = pygame.font.Font(None, font_size)
    text_surf = custom_font.render(text, True, WHITE)
    screen.blit(text_surf, text_surf.get_rect(center=rect.center))

    return is_hovered and click_state[0]


def play_menu_music():
    try:
        pygame.mixer.music.load('title_theme.mp3')
        pygame.mixer.music.play(-1)
    except:
        print('File not found.')


def main():
    global current_state, selected_level, player_x, player_y, defeated_enemies, current_enemy, show_hitboxes, button_hovered, current_level_assets, selected_skin

    play_menu_music()

    while True:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

        if current_state == STATE_MENU:
            screen.fill(GRAY)
            draw_title()

            mouse_pos = pygame.mouse.get_pos()

            if not (
                    pygame.Rect(300, 250, 200, 50).collidepoint(mouse_pos)
                    or pygame.Rect(300, 320, 200, 50).collidepoint(mouse_pos)
            ):
                button_hovered = False

            # PLAY BUTTON
            if draw_button("Play", 300, 250, 200, 50, GREEN, (120, 220, 120)):
                pygame.mixer.music.fadeout(1000)
                pygame.time.delay(150)
                click.play()
                current_state = STATE_LEVEL_SELECT

            # SKIN SELECT BUTTON
            if draw_button("Choose Skin", 300, 320, 200, 50, GREEN, (120, 220, 120)):
                pygame.time.delay(150)
                click.play()
                current_state = STATE_SKIN_SELECT

            pygame.display.flip()




        elif current_state == STATE_LEVEL_SELECT:
            screen.fill(GRAY)
            # Title text
            title_text = font.render("Level Selection", True, WHITE)
            title_rect = title_text.get_rect(center=(SCREEN_WIDTH // 2, 60))
            screen.blit(title_text, title_rect)
            # Load preview images
            grass_preview = pygame.image.load("grass_battle_bg.png").convert()
            grass_preview = pygame.transform.scale(grass_preview, (180, 100))
            volcano_preview = pygame.image.load("volcano_battle_bg.png").convert()
            volcano_preview = pygame.transform.scale(volcano_preview, (180, 100))
            desert_preview = pygame.image.load("desert_battle_bg.png").convert()
            desert_preview = pygame.transform.scale(desert_preview, (180, 100))
            mouse_pos = pygame.mouse.get_pos()
            # Spread out horizontally
            preview_y = 140
            button_y = 260
            level_data = [
                {
                    "name": "Emerald Meadows",
                    "level": 0,
                    "x": 60,
                    "image": grass_preview,
                    'boss': wrath_king
                },
                {
                    "name": "Ember Peak",
                    "level": 1,
                    "x": 310,
                    "image": volcano_preview,
                    'boss': wrath_king
                },
                {
                    "name": "Golden Dunes",
                    "level": 2,
                    "x": 560,
                    "image": desert_preview,
                    'boss': wrath_king
                }
            ]
            hovering_any_button = False
            for level in level_data:
                x = level["x"]

                # draw preview image
                screen.blit(level["image"], (x, preview_y))

                # image border
                pygame.draw.rect(
                    screen,
                    WHITE,
                    pygame.Rect(x, preview_y, 180, 100),
                    2
                )

                button_rect = pygame.Rect(x, button_y, 180, 50)

                if button_rect.collidepoint(mouse_pos):
                    hovering_any_button = True

                # smaller font only for Emerald Meadows
                font_size = 28 if level["name"] == "Emerald Meadows" else 32

                if draw_button(
                        level["name"],
                        x,
                        button_y,
                        180,
                        50,
                        GREEN,
                        (120, 220, 120),
                        font_size
                ):
                    reset_level_state()  # 🔥 important

                    selected_level = level["level"]
                    current_level_assets = level
                    player_x, player_y = 100, 400
                    click.play()
                    current_state = STATE_PLATFORMER
            pygame.display.flip()
            if not hovering_any_button:
                button_hovered = False
        elif current_state == STATE_PLATFORMER:
            res, show_hitboxes, enemy, px, py = platformer_loop(
                screen,
                clock,
                show_hitboxes,
                player_x,
                player_y,
                defeated_enemies,
                selected_level,
                selected_skin
            )

            player_x, player_y = px, py

            if res == "combat":
                current_enemy = enemy
                current_state = STATE_COMBAT

            elif res == "boss":
                print(f"DEBUG: current_enemy type is {type(current_enemy)}")
                boss_data = current_level_assets['boss']
                current_enemy = Enemy(0, 0, 0, boss_data, boss_data, enemy_frames)
                current_state = STATE_COMBAT

            elif res == "menu":
                current_state = STATE_MENU

        elif current_state == STATE_COMBAT:
            print("Main: current_enemy is", type(current_enemy))
            res = combat_loop(screen, clock, current_enemy, selected_skin)

            if res == 'enemy_defeated':
                defeated_enemies[selected_level].append(current_enemy.enemy_id)
                current_enemy = None

            current_state = STATE_PLATFORMER
        elif current_state == STATE_SKIN_SELECT:
            screen.fill(GRAY)

            title_text = font.render("Choose Your Skin", True, WHITE)
            title_rect = title_text.get_rect(center=(SCREEN_WIDTH // 2, 80))
            screen.blit(title_text, title_rect)

            mouse_pos = pygame.mouse.get_pos()

            if not (
                    pygame.Rect(250, 200, 300, 50).collidepoint(mouse_pos)
                    or pygame.Rect(250, 280, 300, 50).collidepoint(mouse_pos)
                    or pygame.Rect(250, 360, 300, 50).collidepoint(mouse_pos)
            ):
                button_hovered = False

            # Example skins
            if draw_button("Alien Skin", 250, 200, 300, 50, GREEN, (120, 220, 120)):
                selected_skin = "alien"
                click.play()

            if draw_button("Elon Skin", 250, 280, 300, 50, GREEN, (120, 220, 120)):
                selected_skin = "elon"
                click.play()

            # NEW THIRD OPTION
            if draw_button("Hatsune Miku", 250, 360, 300, 50, GREEN, (120, 220, 120)):
                selected_skin = "miku"
                click.play()

            # Move Back button lower
            if draw_button("Back", 250, 440, 300, 50, GREEN, (120, 220, 120)):
                click.play()
                current_state = STATE_MENU

            skin_text = small_font.render(f"Current Skin: {selected_skin}", True, WHITE)
            screen.blit(skin_text, (270, 450+85))

            pygame.display.flip()

        clock.tick(60)


if __name__ == "__main__":
    main()
