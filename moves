class Move:
    def __init__(self, name, power, element, points):
        self.name = name
        self.power = power
        self.element = element
        self.points = points

# Player Moves
def get_player_moves(selected_skin):
    if selected_skin == "alien":
        return [
            Move('Dash Attack', 15, 'normal', 10),
            Move('Ray Blast', 20, 'energy', 5),
            Move('Heal', -25, 'normal', 1)
        ]

    elif selected_skin == "elon":
        return [
            Move('Cybertruck Slam', 15, 'normal', 10),
            Move('Twitter Killer', 20, 'energy', 5),
            Move('Tesla Recharge', -25, 'normal', 1)
        ]

    elif selected_skin == "miku":
        return [
            Move('Overdrive Pulse', 15, 'normal', 10),
            Move('Miku Miku Beammm', 30, 'energy', 5),
            Move('Cure.exe (heal)', -25, 'normal', 1)
        ]

    else:
        return [
            Move('Punch', 10, 'normal', 10),
            Move('Kick', 12, 'normal', 5),
            Move('Heal', -20, 'normal', 1)
        ]

